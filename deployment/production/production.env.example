# AgentScan Production Environment Configuration
# Copy this file to production.env and fill in the actual values

# Application Configuration
APP_NAME=AgentScan
APP_VERSION=1.0.0
GO_ENV=production
PORT=8080
HOST=0.0.0.0

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Server Configuration
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://username:password@hostname:5432/agentscan_prod?sslmode=require
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=5m
DATABASE_CONN_MAX_IDLE_TIME=5m

# Redis Configuration
REDIS_URL=redis://username:password@hostname:6379/0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10
REDIS_POOL_TIMEOUT=4s

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_32_characters_or_longer
JWT_ALGORITHM=HS256
JWT_ISSUER=agentscan-prod
JWT_AUDIENCE=agentscan-api
JWT_TTL=24h

# Security Configuration
HTTPS_ENABLED=true
HTTPS_CERT_FILE=/etc/ssl/certs/agentscan.crt
HTTPS_KEY_FILE=/etc/ssl/private/agentscan.key
HTTPS_REDIRECT_HTTP=true

# CORS Configuration
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=https://agentscan.vercel.app,https://app.agentscan.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_EXPOSED_HEADERS=X-Total-Count
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=1h
RATE_LIMIT_BURST=100

# Monitoring Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
HEALTH_CHECK_ENABLED=true
PPROF_ENABLED=false

# Security Headers Configuration
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true
CSP_ENABLED=true
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:
CSP_REPORT_URI=/csp-report

# Encryption Configuration
ENCRYPTION_KEY=your_32_character_encryption_key_here

# External Services Configuration
EXTERNAL_API_TIMEOUT=30s
EXTERNAL_API_RETRIES=3

# File Upload Configuration
MAX_UPLOAD_SIZE=10MB
ALLOWED_FILE_TYPES=.pdf,.txt,.json,.xml,.csv

# Session Configuration
SESSION_TIMEOUT=24h
SESSION_CLEANUP_INTERVAL=1h

# Background Job Configuration
JOB_QUEUE_SIZE=1000
JOB_WORKER_COUNT=10
JOB_TIMEOUT=30m

# Audit Logging Configuration
AUDIT_LOG_ENABLED=true
AUDIT_LOG_EVENTS=authentication_failure,rate_limit_exceeded,cors_violation,security_event

# Performance Configuration
GC_PERCENT=100
MAX_PROCS=0
GOMAXPROCS=0

# Feature Flags
FEATURE_ADVANCED_SCANNING=true
FEATURE_REAL_TIME_UPDATES=true
FEATURE_EXPORT_REPORTS=true
FEATURE_API_V2=false

# Third-party Integrations
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
DATADOG_API_KEY=your_datadog_api_key
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=agentscan-backups
BACKUP_S3_REGION=us-west-2

# SSL/TLS Configuration
TLS_MIN_VERSION=1.2
TLS_CIPHER_SUITES=TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256

# Development/Debug (should be false in production)
DEBUG=false
ENABLE_PPROF=false
ENABLE_DEBUG_ENDPOINTS=false