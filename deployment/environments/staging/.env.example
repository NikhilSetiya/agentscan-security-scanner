# AgentScan Staging Environment Variables\n# Copy this file to .env and fill in the actual values\n# This is for staging/testing environment\n\n# =============================================================================\n# Database Configuration (Staging)\n# =============================================================================\nDB_HOST=your-staging-db-host.com\nDB_PORT=5432\nDB_NAME=agentscan_staging\nDB_USER=agentscan_staging_user\nDB_PASSWORD=your-staging-database-password\n\n# =============================================================================\n# Redis Configuration (Staging)\n# =============================================================================\nREDIS_HOST=your-staging-redis-host.com\nREDIS_PORT=6379\nREDIS_PASSWORD=your-staging-redis-password\n\n# =============================================================================\n# Supabase Configuration (Staging Project)\n# =============================================================================\nSUPABASE_URL=https://your-staging-project-id.supabase.co\nSUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\nSUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\nSUPABASE_STAGING_PROJECT_ID=your-staging-project-id\n\n# =============================================================================\n# Security Configuration (Staging Keys)\n# =============================================================================\nJWT_SECRET=your-staging-jwt-secret-different-from-production\nENCRYPTION_KEY=your-staging-encryption-key\nSIGNING_KEY=your-staging-signing-key\n\n# =============================================================================\n# GitHub OAuth Configuration (Staging App)\n# =============================================================================\nGITHUB_CLIENT_ID=Ov23liYourStagingGitHubClientId\nGITHUB_SECRET=your-staging-github-oauth-secret\n\n# =============================================================================\n# SMTP Configuration (Staging/Test SMTP)\n# =============================================================================\nSMTP_HOST=smtp.mailtrap.io\nSMTP_PORT=2525\nSMTP_USER=your-mailtrap-username\nSMTP_PASSWORD=your-mailtrap-password\n\n# =============================================================================\n# Notification Configuration (Staging Channels)\n# =============================================================================\nSLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/STAGING/WEBHOOK\nWEBHOOK_URL=https://your-staging-webhook.com/webhook\nWEBHOOK_SECRET=your-staging-webhook-secret\n\n# =============================================================================\n# Monitoring Configuration (Staging)\n# =============================================================================\nPROMETHEUS_PASSWORD=your-staging-prometheus-password\nGRAFANA_ADMIN_PASSWORD=your-staging-grafana-password\n\n# =============================================================================\n# External Service Integration (Test Tokens)\n# =============================================================================\nGITHUB_TOKEN=ghp_your-staging-github-token\nDOCKER_REGISTRY_TOKEN=your-staging-registry-token\n\n# =============================================================================\n# Application Configuration\n# =============================================================================\nAPP_ENV=staging\nAPP_DEBUG=true\nAPP_LOG_LEVEL=debug\n\n# =============================================================================\n# Performance Configuration (Lower for staging)\n# =============================================================================\nMAX_CONCURRENT_SCANS=3\nDEFAULT_SCAN_TIMEOUT=15m\nCACHE_TTL=30m\n\n# =============================================================================\n# Feature Flags (All enabled for testing)\n# =============================================================================\nENABLE_REAL_TIME_UPDATES=true\nENABLE_ADVANCED_ANALYTICS=true\nENABLE_API_RATE_LIMITING=true\nENABLE_AUDIT_LOGGING=true\nENABLE_MULTI_TENANT=true\n\n# =============================================================================\n# Deployment Configuration\n# =============================================================================\nDEPLOYMENT_ENVIRONMENT=staging\nKUBERNETES_NAMESPACE=agentscan-staging\nDOCKER_REGISTRY=your-registry.com/agentscan\nIMAGE_TAG=staging\n\n# =============================================================================\n# Testing Configuration\n# =============================================================================\nTEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/agentscan_test\nTEST_REDIS_URL=redis://localhost:6379/1\nENABLE_TEST_MODE=true\n"