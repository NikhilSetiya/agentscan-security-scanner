# AgentScan Production Environment Variables\n# Copy this file to .env and fill in the actual values\n# WARNING: Never commit the actual .env file to version control!\n\n# =============================================================================\n# Database Configuration\n# =============================================================================\nDB_HOST=your-production-db-host.com\nDB_PORT=5432\nDB_NAME=agentscan_production\nDB_USER=agentscan_user\nDB_PASSWORD=your-secure-database-password\n\n# =============================================================================\n# Redis Configuration\n# =============================================================================\nREDIS_HOST=your-production-redis-host.com\nREDIS_PORT=6379\nREDIS_PASSWORD=your-secure-redis-password\n\n# =============================================================================\n# Supabase Configuration\n# =============================================================================\nSUPABASE_URL=https://your-project-id.supabase.co\nSUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\nSUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\nSUPABASE_PROJECT_ID=your-project-id\n\n# =============================================================================\n# Security Configuration\n# =============================================================================\nJWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long\nENCRYPTION_KEY=your-32-byte-hex-encryption-key\nSIGNING_KEY=your-signing-key-for-api-tokens\n\n# =============================================================================\n# GitHub OAuth Configuration\n# =============================================================================\nGITHUB_CLIENT_ID=Ov23liYourGitHubClientId\nGITHUB_SECRET=your-github-oauth-client-secret\n\n# =============================================================================\n# SMTP Configuration (for email notifications)\n# =============================================================================\nSMTP_HOST=smtp.your-email-provider.com\nSMTP_PORT=587\nSMTP_USER=your-smtp-username\nSMTP_PASSWORD=your-smtp-password\n\n# =============================================================================\n# Notification Configuration\n# =============================================================================\nSLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK\nWEBHOOK_URL=https://your-webhook-endpoint.com/webhook\nWEBHOOK_SECRET=your-webhook-secret-for-verification\n\n# =============================================================================\n# Monitoring Configuration\n# =============================================================================\nPROMETHEUS_PASSWORD=your-prometheus-admin-password\nGRAFANA_ADMIN_PASSWORD=your-grafana-admin-password\n\n# =============================================================================\n# External Service Integration\n# =============================================================================\nGITHUB_TOKEN=ghp_your-github-personal-access-token\nDOCKER_REGISTRY_TOKEN=your-docker-registry-token\n\n# =============================================================================\n# TLS/SSL Configuration\n# =============================================================================\nTLS_CERT_PATH=/path/to/your/tls/certificate.crt\nTLS_KEY_PATH=/path/to/your/tls/private.key\n\n# =============================================================================\n# Application Configuration\n# =============================================================================\nAPP_ENV=production\nAPP_DEBUG=false\nAPP_LOG_LEVEL=info\n\n# =============================================================================\n# Performance Configuration\n# =============================================================================\nMAX_CONCURRENT_SCANS=5\nDEFAULT_SCAN_TIMEOUT=30m\nCACHE_TTL=1h\n\n# =============================================================================\n# Feature Flags\n# =============================================================================\nENABLE_REAL_TIME_UPDATES=true\nENABLE_ADVANCED_ANALYTICS=true\nENABLE_API_RATE_LIMITING=true\nENABLE_AUDIT_LOGGING=true\n\n# =============================================================================\n# Deployment Configuration\n# =============================================================================\nDEPLOYMENT_ENVIRONMENT=production\nKUBERNETES_NAMESPACE=agentscan\nDOCKER_REGISTRY=your-registry.com/agentscan\nIMAGE_TAG=latest\n"