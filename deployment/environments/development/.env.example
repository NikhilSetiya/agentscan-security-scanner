# AgentScan Development Environment Variables\n# Copy this file to .env and fill in the actual values\n# This is for local development environment\n\n# =============================================================================\n# Database Configuration (Local)\n# =============================================================================\nDB_HOST=localhost\nDB_PORT=5432\nDB_NAME=agentscan_dev\nDB_USER=postgres\nDB_PASSWORD=postgres\n\n# =============================================================================\n# Redis Configuration (Local)\n# =============================================================================\nREDIS_HOST=localhost\nREDIS_PORT=6379\nREDIS_PASSWORD=\n\n# =============================================================================\n# Supabase Configuration (Optional for local dev)\n# =============================================================================\n# Use local Supabase or remote development project\nSUPABASE_URL=http://localhost:54321\n# Default Supabase local development keys\nSUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0\nSUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU\n\n# =============================================================================\n# Security Configuration (Development - Not secure!)\n# =============================================================================\nJWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long\nENCRYPTION_KEY=dev-encryption-key-not-for-production-use-only\nSIGNING_KEY=dev-signing-key-not-secure\n\n# =============================================================================\n# GitHub OAuth Configuration (Development App)\n# =============================================================================\n# Create a separate GitHub OAuth app for development\nGITHUB_CLIENT_ID=Ov23liYourDevGitHubClientId\nGITHUB_SECRET=your-dev-github-oauth-secret\n\n# =============================================================================\n# SMTP Configuration (Local/Test)\n# =============================================================================\n# Use MailHog or similar for local email testing\nSMTP_HOST=localhost\nSMTP_PORT=1025\nSMTP_USER=\nSMTP_PASSWORD=\n\n# =============================================================================\n# Notification Configuration (Disabled for dev)\n# =============================================================================\n# SLACK_WEBHOOK_URL=\n# WEBHOOK_URL=http://localhost:8081/webhook\n# WEBHOOK_SECRET=dev-webhook-secret\n\n# =============================================================================\n# Monitoring Configuration (Local)\n# =============================================================================\nPROMETHEUS_PASSWORD=admin\nGRAFANA_ADMIN_PASSWORD=admin\n\n# =============================================================================\n# External Service Integration (Optional)\n# =============================================================================\n# GITHUB_TOKEN=ghp_your-personal-access-token-for-testing\n# DOCKER_REGISTRY_TOKEN=\n\n# =============================================================================\n# Application Configuration\n# =============================================================================\nAPP_ENV=development\nAPP_DEBUG=true\nAPP_LOG_LEVEL=debug\n\n# =============================================================================\n# Performance Configuration (Minimal for dev)\n# =============================================================================\nMAX_CONCURRENT_SCANS=2\nDEFAULT_SCAN_TIMEOUT=5m\nCACHE_TTL=5m\n\n# =============================================================================\n# Feature Flags (All enabled for testing)\n# =============================================================================\nENABLE_REAL_TIME_UPDATES=true\nENABLE_ADVANCED_ANALYTICS=true\nENABLE_API_RATE_LIMITING=false\nENABLE_AUDIT_LOGGING=true\nENABLE_MULTI_TENANT=true\n\n# =============================================================================\n# Development Configuration\n# =============================================================================\nDEPLOYMENT_ENVIRONMENT=development\nDOCKER_REGISTRY=localhost:5000/agentscan\nIMAGE_TAG=dev\n\n# =============================================================================\n# Local Development Tools\n# =============================================================================\n# Enable development tools and debugging\nENABLE_HOT_RELOAD=true\nENABLE_DEBUG_ENDPOINTS=true\nENABLE_PROFILING=true\n\n# =============================================================================\n# Testing Configuration\n# =============================================================================\nTEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentscan_test\nTEST_REDIS_URL=redis://localhost:6379/1\nENABLE_TEST_MODE=true\n\n# =============================================================================\n# Local Service URLs\n# =============================================================================\nAPI_URL=http://localhost:8080\nFRONTEND_URL=http://localhost:3000\nORCHESTRATOR_URL=http://localhost:8081\n\n# =============================================================================\n# Development Database Seeding\n# =============================================================================\nSEED_DATABASE=true\nCREATE_SAMPLE_DATA=true\nSAMPLE_USER_EMAIL=dev@agentscan.local\nSAMPLE_USER_PASSWORD=password123\n"