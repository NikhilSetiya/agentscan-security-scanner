# Production Environment Configuration for AgentScan
# This file contains production-specific environment variables
# Copy this to .env in production and update values accordingly

# Application Environment
GO_ENV=production
APP_NAME=AgentScan Security Scanner
APP_VERSION=1.0.0
APP_DEBUG=false

# Server Configuration
PORT=8080
HOST=0.0.0.0
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=30s

# HTTPS Configuration
HTTPS_ENABLED=true
HTTPS_PORT=443
TLS_CERT_FILE=/etc/ssl/certs/agentscan.crt
TLS_KEY_FILE=/etc/ssl/private/agentscan.key
HTTPS_REDIRECT_HTTP=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/agentscan_production?sslmode=require
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=5m
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_SSL_MODE=require

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your_redis_password_here
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5
REDIS_POOL_TIMEOUT=4s
REDIS_IDLE_TIMEOUT=5m

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# JWT Configuration
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here_at_least_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h
JWT_ISSUER=agentscan.io
JWT_AUDIENCE=agentscan.io

# CORS Configuration
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=https://app.agentscan.io,https://agentscan.vercel.app
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-Token,X-Requested-With,X-API-Key
CORS_EXPOSED_HEADERS=X-Total-Count,X-Page-Count,X-Rate-Limit-Remaining
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_REQUESTS=1000
RATE_LIMIT_GLOBAL_WINDOW=1h
RATE_LIMIT_GLOBAL_BURST=100

# Authentication Rate Limits
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW=15m
RATE_LIMIT_LOGIN_BURST=2
RATE_LIMIT_REGISTER_REQUESTS=3
RATE_LIMIT_REGISTER_WINDOW=1h
RATE_LIMIT_REGISTER_BURST=1

# API Rate Limits
RATE_LIMIT_SCANS_REQUESTS=10
RATE_LIMIT_SCANS_WINDOW=1h
RATE_LIMIT_SCANS_BURST=3

# User Tier Rate Limits
RATE_LIMIT_FREE_REQUESTS=100
RATE_LIMIT_FREE_WINDOW=24h
RATE_LIMIT_FREE_BURST=10
RATE_LIMIT_PRO_REQUESTS=1000
RATE_LIMIT_PRO_WINDOW=24h
RATE_LIMIT_PRO_BURST=50

# Session Configuration
SESSION_COOKIE_NAME=agentscan_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=Strict
SESSION_COOKIE_DOMAIN=.agentscan.io
SESSION_COOKIE_PATH=/
SESSION_MAX_AGE=24h
SESSION_IDLE_TIMEOUT=2h

# Content Security Policy
CSP_ENABLED=true
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self','unsafe-inline',https://cdn.jsdelivr.net
CSP_STYLE_SRC='self','unsafe-inline',https://fonts.googleapis.com
CSP_IMG_SRC='self',data:,https:,blob:
CSP_CONNECT_SRC='self',https://api.agentscan.io,wss://api.agentscan.io,https://*.supabase.co
CSP_FONT_SRC='self',https://fonts.gstatic.com
CSP_OBJECT_SRC='none'
CSP_MEDIA_SRC='self'
CSP_FRAME_SRC='none'
CSP_REPORT_URI=/api/v1/csp-report
CSP_REPORT_ONLY=false

# Security Headers
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
XSS_PROTECTION=1; mode=block
REFERRER_POLICY=strict-origin-when-cross-origin
PERMISSIONS_POLICY=geolocation=(), microphone=(), camera=()
CROSS_ORIGIN_EMBEDDER_POLICY=require-corp
CROSS_ORIGIN_OPENER_POLICY=same-origin
CROSS_ORIGIN_RESOURCE_POLICY=same-origin

# API Security
API_REQUIRE_API_KEY=false
API_REQUIRE_AUTH=true
API_BLOCKED_USER_AGENTS=curl,wget,python-requests
API_MAX_REQUEST_SIZE=10485760
API_REQUEST_TIMEOUT=30s

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE_PATH=/var/log/agentscan/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=5
LOG_MAX_AGE=30
LOG_COMPRESS=true

# Monitoring and Observability
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
PPROF_ENABLED=false

# External Services
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# Email Configuration (if using SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@agentscan.io
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=AgentScan <noreply@agentscan.io>

# File Storage (if using local storage)
STORAGE_TYPE=supabase
STORAGE_LOCAL_PATH=/var/lib/agentscan/uploads
STORAGE_MAX_FILE_SIZE=10485760

# Background Jobs
WORKER_CONCURRENCY=10
WORKER_QUEUE_SIZE=1000
JOB_TIMEOUT=300s
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY=30s

# Feature Flags
FEATURE_REAL_TIME_SCANNING=true
FEATURE_BULK_OPERATIONS=true
FEATURE_ADVANCED_REPORTING=true
FEATURE_API_V2=false

# Performance Configuration
CACHE_TTL=1h
CACHE_CLEANUP_INTERVAL=10m
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT=600s

# Security Scanning Configuration
SCANNER_TIMEOUT=300s
SCANNER_MAX_FILE_SIZE=52428800
SCANNER_EXCLUDED_PATHS=node_modules,vendor,.git,dist,build
SCANNER_MAX_FINDINGS=1000

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=agentscan-backups
BACKUP_S3_REGION=us-east-1